<?xml version="1.0" encoding="utf-8"?>
<!--
  Revit Add-in Manifest File
  ==========================
  This file tells Revit how to load the add-in. It must be placed in:
    %ProgramData%\Autodesk\Revit\Addins\{RevitVersion}\

  The build process automatically copies this file to the Revit Addins folder.

  Key elements:
    - Type="Application": Loads on Revit startup (vs Type="Command" for on-demand)
    - Assembly: Relative path from this .addin file to the main DLL
    - FullClassName: The IExternalApplication class that Revit calls on startup
    - ClientId: Unique GUID identifying this add-in (generate new for your project)
-->
<RevitAddIns>
	<AddIn Type="Application">
		<!-- Display name shown in Revit's Add-in Manager -->
		<Name>Pilot</Name>

		<!-- Path to main assembly, relative to this .addin file's location -->
		<!-- The DLLs are in a "Pilot" subfolder next to this file -->
		<Assembly>Pilot\pilot.dll</Assembly>

		<!-- Entry point class implementing IExternalApplication -->
		<FullClassName>Pilot.Main</FullClassName>

		<!-- Unique identifier - generate a new GUID for your own project -->
		<ClientId>a1b2c3d4-e5f6-7890-abcd-ef1234567890</ClientId>

		<!-- Vendor information displayed in Add-in Manager -->
		<VendorId>Pilot</VendorId>
		<VendorDescription>Pilot Revit Add-in</VendorDescription>
	</AddIn>
</RevitAddIns>
