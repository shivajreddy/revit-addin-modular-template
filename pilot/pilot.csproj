<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RevitVersion>2026</RevitVersion>
    <RevitAddinsFolder>$(ProgramData)\Autodesk\Revit\Addins\$(RevitVersion)</RevitAddinsFolder>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\pilot.core\pilot.core.csproj" />
    <ProjectReference Include="..\pilot.res\pilot.res.csproj" />
    <ProjectReference Include="..\pilot.ui\pilot.ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>..\lib\revit2026\RevitAPI.dll</HintPath>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>..\lib\revit2026\RevitAPIUI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToRevitAddins" AfterTargets="Build">
    <!-- Create Pilot folder in Revit Addins -->
    <MakeDir Directories="$(RevitAddinsFolder)\Pilot" />

    <!-- Copy .addin manifest -->
    <Copy SourceFiles="$(ProjectDir)..\..\addin\Pilot.addin" DestinationFolder="$(RevitAddinsFolder)" />

    <!-- Copy all DLLs from output -->
    <Copy SourceFiles="$(TargetDir)pilot.dll" DestinationFolder="$(RevitAddinsFolder)\Pilot" />
    <Copy SourceFiles="$(TargetDir)pilot.core.dll" DestinationFolder="$(RevitAddinsFolder)\Pilot" />
    <Copy SourceFiles="$(TargetDir)pilot.ui.dll" DestinationFolder="$(RevitAddinsFolder)\Pilot" />
    <Copy SourceFiles="$(TargetDir)pilot.res.dll" DestinationFolder="$(RevitAddinsFolder)\Pilot" />
  </Target>

</Project>
